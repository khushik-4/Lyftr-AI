# Lyftr AI Environment Configuration Template
# Copy this file to .env and insert your real API credentials.

# Comma-separated list of at least 2 LLM API keys for automatic failover.
# Preserves order: key_1 -> first key, key_2 -> second key.
LLM_API_KEYS=your_primary_gemini_key,your_secondary_gemini_key

# LiteLLM model identifier (supports Gemini, OpenAI, Claude, etc.)
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite Database Location.
# When running with Docker, use the mounted volume path: sqlite:////data/app.db
# When running locally without Docker: sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable/disable X-Simulate-Failure header for testing failovers on demand
ENABLE_FAILURE_SIMULATION=true

# Frontend API base URL (Vite build-time and runtime)
VITE_API_BASE_URL=http://localhost:8000
